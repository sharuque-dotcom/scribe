{
  "name": "scribe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Click through any website, capture annotated screenshots, and turn them into SOPs and training material.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-ext.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "node tests/e2e.mjs && node tests/e2e-ai.mjs && node tests/e2e-video.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@mediabunny/aac-encoder": "^1.64.0",
    "dompurify": "^3.4.17",
    "kokoro-js": "^1.2.1",
    "marked": "^18.1.1",
    "mediabunny": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
