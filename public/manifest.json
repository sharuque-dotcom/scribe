{
  "manifest_version": 3,
  "name": "StepCrumb",
  "short_name": "StepCrumb",
  "version": "1.0.1",
  "description": "Click through any task once. Get a step-by-step guide, SOP, training and a narrated video. Private: all saved on your computer.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "StepCrumb",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabs", "storage", "scripting", "unlimitedStorage", "tabCapture", "offscreen", "alarms"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "host_permissions": ["<all_urls>", "https://api.polar.sh/*"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Start or stop capturing"
    }
  }
}
